{
  "name": "dewee-chrome-ext",
  "version": "0.1.0",
  "private": true,
  "description": "Dewee Chrome Extension: secure multi-workspace agent chat, Super Agent and credential requests in a Chrome side panel",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:advanced": "node scripts/build-advanced.mjs",
    "zip": "wxt zip",
    "zip:advanced": "node scripts/build-advanced.mjs zip",
    "zip:store": "node scripts/zip-store.mjs",
    "postinstall": "wxt prepare",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:e2e": "node scripts/build-e2e.mjs",
    "build:e2e:advanced": "node scripts/build-e2e.mjs --profile advanced",
    "test:e2e": "node scripts/build-e2e.mjs && playwright test",
    "bench:browser": "node scripts/bench-browser-control.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "0.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
