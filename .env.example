# Build-time, non-secret. Cloud origin used by the "Dewee Cloud" profile.
WXT_DEWEE_CLOUD_ORIGIN=https://app.dewee.sh

# Live Playwright scenarios only (never baked into the build). Use a personal,
# owner-bound API key with operator.read + operator.write — never the master token.
E2E_GATEWAY_URL=http://localhost:18790
E2E_GATEWAY_API_KEY=
E2E_WORKSPACE_ID=
# Live revocation scenario only, local test gateway: the key owner and the gateway admin token.
E2E_OWNER_ID=
E2E_GATEWAY_ADMIN_TOKEN=
